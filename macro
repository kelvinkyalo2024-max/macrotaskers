  const card=document.createElement("article");

  card.className="day-card "+(i===active?"active":"locked");

  card.style.setProperty("--day-accent",d[3]);

  card.innerHTML=`
   <div class="day-top">
    <span class="day-number">0${i+1}</span>
    <span class="muted" style="font-size:11px">${done}/10 complete</span>
   </div>

   <h3>${d[1]}</h3>
   <p>${d[4]} · ${d[0]}</p>

   <div class="progress">
    <span style="width:${done*10}%"></span>
   </div>

   <button class="${i===active?"btn-gold":"btn-dark"} btn-small"
    ${i!==active?"disabled":""}
    onclick="showTasks(${i})">
    ${i===active?"Open today's tier":"Available on "+d[0]}
   </button>
  `;

  grid.appendChild(card);
 });

 document.getElementById("balance").textContent=
 "KSh "+state.balance.toLocaleString("en-KE");

 document.getElementById("completedStat").textContent=
 state.completed.length+" / 70";

 document.getElementById("earnedText").textContent=
 state.completed.length+" completed task(s) × KSh 300 task credit";
}

function showTasks(day){

 if(day!==todayIndex())return;

 const d=DAYS[day];
 const container=document.getElementById("dayGrid");

 const existing=document.getElementById("taskPanel");

 if(existing)existing.remove();

 const panel=document.createElement("section");

 panel.id="taskPanel";
 panel.className="day-card";
 panel.style.gridColumn="1 / -1";
 panel.style.setProperty("--day-accent",d[3]);

 panel.innerHTML=`
  <div class="day-top">
   <div>
    <div class="eyebrow">${d[0]} · DAILY CHALLENGES</div>
    <h2 style="margin:6px 0">${d[1]}</h2>
   </div>
   <span class="day-number">10 TASKS</span>
  </div>

  <p>Each task opens with its own 4-digit access code. Complete and submit each task once.</p>

  <div class="task-list" id="taskList"></div>
 `;

 container.appendChild(panel);

 const list=panel.querySelector("#taskList");

 TASKS[day].forEach((t,i)=>{

  const done=state.completed.includes(t.id);

  const el=document.createElement("div");

  el.className="task "+(done?"done":"");

  el.innerHTML=`
   <div>
    <strong>${String(i+1).padStart(2,"0")} · ${done?"Completed":"Challenge "+(i+1)}</strong>
    <small>${t.type==="audio"?"Audio clue":t.type==="visual"?"Visual reasoning":"Text challenge"} · ${done?"Submitted":"KSh 300 task credit"}</small>
   </div>

   <button class="${done?"btn-dark":"btn-gold"} btn-small"
    ${done?"disabled":""}>
    ${done?"Done":"Open"}
   </button>
  `;

  if(!done){
   el.querySelector("button").onclick=()=>openTask(day,i);
  }

  list.appendChild(el);
 });

 panel.scrollIntoView({behavior:"smooth",block:"start"});
}

function openTask(day,index){

 currentTask=TASKS[day][index];
 selectedAnswer=null;
 unlocked=false;

 document.getElementById("modalDay").textContent=
 DAYS[day][0].toUpperCase()+" · TASK "+(index+1);

 document.getElementById("modalTitle").textContent=
 "Challenge "+(index+1);

 document.getElementById("modalDesc").textContent=
 "Enter the access code to open this task.";

 document.getElementById("accessCode").value="";

 document.getElementById("codeStage").style.display="block";
 document.getElementById("quizStage").style.display="none";

 document.getElementById("modalBackdrop").style.display="flex";
}

function unlockTask(){

 const entered=document.getElementById("accessCode").value.trim();

 if(!/^\d{4}$/.test(entered)){
  alert("Enter a valid 4-digit code.");
  return;
 }

 if(entered!==currentTask.code){
  alert("That code is not correct. Contact admin if you need the task code.");
  return;
 }

 unlocked=true;

 document.getElementById("codeStage").style.display="none";
 document.getElementById("quizStage").style.display="block";

 document.getElementById("questionText").textContent=currentTask.q;

 document.getElementById("typeLabel").textContent=
 currentTask.type==="audio"
 ? "AUDIO TASK · Listen to the clue, then choose an answer."
 : currentTask.type==="visual"
 ? "VISUAL TASK · Observe the symbols or choices carefully."
 : "TEXT TASK · Read the question and choose the best answer.";

 document.getElementById("audioBtn").style.display=
 currentTask.type==="audio"?"inline-block":"none";

 const opts=document.getElementById("options");
 opts.innerHTML="";

 currentTask.opts.forEach((o,i)=>{

  const b=document.createElement("button");
  b.className="option";
  b.textContent=String.fromCharCode(65+i)+". "+o;

  b.onclick=()=>{
   selectedAnswer=i;
   [...opts.children].forEach(x=>x.classList.remove("selected"));
   b.classList.add("selected");
  };

  opts.appendChild(b);
 });

 document.getElementById("quizFeedback").style.display="none";
 document.getElementById("submitBtn").disabled=false;
}

function playAudio(){

 if(!("speechSynthesis" in window)){
  alert("Audio playback is not supported by this browser.");
  return;
 }

 const utter=new SpeechSynthesisUtterance(currentTask.q);
 utter.rate=.9;

 window.speechSynthesis.cancel();
 window.speechSynthesis.speak(utter);
}

function submitTask(){

 if(!unlocked||selectedAnswer===null){
  alert("Choose an answer before submitting.");
  return;
 }

 const fb=document.getElementById("quizFeedback");
 fb.style.display="block";

 if(selectedAnswer!==currentTask.answer){

  fb.className="feedback error";
  fb.textContent="Not quite. Review the question and try again.";
  return;
 }

 if(!state.completed.includes(currentTask.id)){

  state.completed.push(currentTask.id);
  state.balance+=300;

  saveSession();
  render();
 }

 fb.className="feedback success";

 fb.textContent=
 "Submission successful! Please take a screenshot and send it to admin for verification and tracking. Your task has been marked complete in this browser session.";

 document.getElementById("submitBtn").disabled=true;
}

function contactAdmin(){

 const msg=encodeURIComponent(
  "Hello admin, I need the 4-digit access code for Macro taskter$ "+
  (currentTask?currentTask.id:"a task")+"."
 );

 window.open("https://wa.me/"+ADMIN_WA+"?text="+msg,"_blank");
}

function closeModal(){

 document.getElementById("modalBackdrop").style.display="none";

 if(window.speechSynthesis){
  window.speechSynthesis.cancel();
 }

 currentTask=null;
}

function withdraw(){

 const amountInput=document.getElementById("withdrawAmount");
 const phoneInput=document.getElementById("safaricomNumber");

 const amount=Number(amountInput.value);
 const phone=phoneInput.value.trim();

 if(!amountInput.value||!Number.isFinite(amount)||amount<=0){
  alert("Please enter a valid withdrawal amount.");
  return;
 }

 if(!/^07\d{8}$/.test(phone)){
  alert("Please enter a valid Safaricom number in the format 07XXXXXXXX.");
  return;
 }

 if(amount>state.balance){
  alert("Insufficient wallet balance.");
  return;
 }

 alert("Withdrawal on Sunday");

}

// INITIALIZE WEBSITE

loadSession();
render();
updateCountdown();

setInterval(updateCountdown,1000);

document.getElementById("modalBackdrop").addEventListener("click",e=>{
 if(e.target.id==="modalBackdrop")closeModal();
});

</script>
</body>
</html>
